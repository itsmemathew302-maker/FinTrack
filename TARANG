<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#050b1c">
  <meta name="description" content="TARANG — Alumni Meet at New Prince Shri Bhavani College of Engineering and Technology">
  <title>TARANG | Alumni Meet 2026</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --navy: #050b1c;
      --navy-2: #09142d;
      --blue: #0c2d68;
      --blue-bright: #1c67d8;
      --gold: #d4af37;
      --gold-light: #ffe9a3;
      --gold-dark: #8e6b16;
      --white: #f8fbff;
      --muted: #9ba9c5;
      --glass: rgba(255,255,255,0.055);
      --border: rgba(212,175,55,0.25);
      --shadow: 0 25px 80px rgba(0,0,0,0.4);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      background:
        radial-gradient(circle at 50% 0%, rgba(20,75,160,0.22), transparent 35%),
        var(--navy);
      color: var(--white);
      font-family: "Inter", sans-serif;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 1000;
      pointer-events: none;
      background:
        radial-gradient(
          500px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
          rgba(212,175,55,0.085),
          transparent 55%
        );
    }

    ::selection {
      color: var(--navy);
      background: var(--gold-light);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    /* =========================================
       LOADER
    ========================================= */

    .loader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: grid;
      place-items: center;
      background: var(--navy);
      transition: opacity 0.8s ease, visibility 0.8s ease;
    }

    .loader.hidden {
      opacity: 0;
      visibility: hidden;
    }

    .loader-content {
      text-align: center;
    }

    .loader-logo {
      font-family: "Cinzel", serif;
      font-size: clamp(3rem, 10vw, 7rem);
      font-weight: 800;
      letter-spacing: 0.18em;
      color: var(--gold);
      animation: logoPulse 1.5s ease-in-out infinite alternate;
    }

    .loader-line {
      width: 180px;
      height: 2px;
      margin: 20px auto;
      overflow: hidden;
      background: rgba(212,175,55,0.15);
    }

    .loader-line::after {
      content: "";
      display: block;
      width: 50%;
      height: 100%;
      background: var(--gold);
      animation: loading 1.2s ease-in-out infinite;
    }

    @keyframes loading {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(300%); }
    }

    @keyframes logoPulse {
      from { opacity: 0.55; }
      to { opacity: 1; text-shadow: 0 0 30px rgba(212,175,55,0.4); }
    }

    /* =========================================
       PARTICLES
    ========================================= */

    #particles {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
    }

    .particle {
      position: absolute;
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--gold);
      opacity: 0.35;
      animation: floatParticle linear infinite;
    }

    @keyframes floatParticle {
      from {
        transform: translateY(110vh) scale(0);
        opacity: 0;
      }

      15% {
        opacity: 0.45;
      }

      85% {
        opacity: 0.25;
      }

      to {
        transform: translateY(-10vh) scale(1);
        opacity: 0;
      }
    }

    /* =========================================
       NAVIGATION
    ========================================= */

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 500;
      padding: 22px 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: 0.4s ease;
    }

    .nav.scrolled {
      padding-top: 14px;
      padding-bottom: 14px;
      background: rgba(5,11,28,0.78);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(212,175,55,0.12);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: "Cinzel", serif;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--gold-light);
    }

    .brand-mark {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border: 1px solid var(--gold);
      transform: rotate(45deg);
    }

    .brand-mark span {
      transform: rotate(-45deg);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 35px;
      font-size: 0.85rem;
      color: var(--muted);
    }

    .nav-links a {
      position: relative;
      transition: color 0.3s ease;
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -7px;
      width: 0;
      height: 1px;
      background: var(--gold);
      transition: width 0.3s ease;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .menu-btn {
      display: none;
      width: 42px;
      height: 42px;
      border: 1px solid var(--border);
      background: var(--glass);
      color: white;
      border-radius: 50%;
      cursor: pointer;
    }

    /* =========================================
       HERO
    ========================================= */

    .hero {
      min-height: 100vh;
      min-height: 100svh;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
      padding: 100px 5% 60px;
    }

    .hero::before {
      content: "";
      position: absolute;
      width: 70vw;
      height: 70vw;
      max-width: 900px;
      max-height: 900px;
      border-radius: 50%;
      border: 1px solid rgba(212,175,55,0.08);
      box-shadow:
        0 0 100px rgba(22,91,190,0.08),
        inset 0 0 100px rgba(22,91,190,0.06);
      animation: slowRotate 25s linear infinite;
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 45vw;
      height: 45vw;
      max-width: 600px;
      max-height: 600px;
      border-radius: 50%;
      border: 1px dashed rgba(212,175,55,0.12);
      animation: slowRotateReverse 18s linear infinite;
    }

    @keyframes slowRotate {
      to { transform: rotate(360deg); }
    }

    @keyframes slowRotateReverse {
      to { transform: rotate(-360deg); }
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 1000px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 25px;
      color: var(--gold-light);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.28em;
      text-transform: uppercase;
    }

    .eyebrow::before,
    .eyebrow::after {
      content: "";
      width: 35px;
      height: 1px;
      background: var(--gold);
    }

    .hero-title {
      font-family: "Cinzel", serif;
      font-size: clamp(5rem, 16vw, 12rem);
      line-height: 0.8;
      letter-spacing: 0.06em;
      font-weight: 800;
      background: linear-gradient(
        135deg,
        #fff5c7 0%,
        var(--gold) 30%,
        #fff1a6 50%,
        #a97d1b 72%,
        #fff1a6 100%
      );
      background-size: 250% auto;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: goldShimmer 6s linear infinite;
      text-shadow: 0 15px 60px rgba(212,175,55,0.1);
    }

    @keyframes goldShimmer {
      to { background-position: 250% center; }
    }

    .hero-subtitle {
      margin: 35px auto 0;
      max-width: 750px;
      font-size: clamp(0.95rem, 2vw, 1.2rem);
      line-height: 1.8;
      color: var(--muted);
    }

    .hero-subtitle strong {
      color: var(--white);
      font-weight: 600;
    }

    .hero-details {
      margin: 35px auto 0;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .detail-pill {
      padding: 11px 18px;
      border: 1px solid rgba(212,175,55,0.18);
      background: rgba(255,255,255,0.035);
      border-radius: 100px;
      color: #d8e1f3;
      font-size: 0.8rem;
      backdrop-filter: blur(10px);
    }

    .detail-pill span {
      color: var(--gold-light);
    }

    .hero-buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 15px;
      margin-top: 35px;
    }

    .btn {
      position: relative;
      min-width: 165px;
      padding: 15px 25px;
      border-radius: 100px;
      border: 1px solid var(--gold);
      cursor: pointer;
      overflow: hidden;
      transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
    }

    .btn:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 40px rgba(212,175,55,0.2);
    }

    .btn-primary {
      background: linear-gradient(135deg, #f0d26a, #b98b20);
      color: #081027;
      font-weight: 800;
    }

    .btn-secondary {
      background: rgba(255,255,255,0.04);
      color: var(--gold-light);
      backdrop-filter: blur(10px);
    }

    .btn .shine {
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255,255,255,0.35),
        transparent
      );
      transform: skewX(-20deg);
      transition: 0.7s ease;
    }

    .btn:hover .shine {
      left: 150%;
    }

    .scroll-indicator {
      position: absolute;
      bottom: 25px;
      left: 50%;
      transform: translateX(-50%);
      color: rgba(255,255,255,0.45);
      font-size: 0.68rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .scroll-indicator::after {
      content: "";
      display: block;
      width: 1px;
      height: 40px;
      margin: 10px auto 0;
      background: linear-gradient(var(--gold), transparent);
      animation: scrollLine 1.5s ease-in-out infinite;
    }

    @keyframes scrollLine {
      50% { transform: translateY(10px); }
    }

    /* =========================================
       SECTIONS
    ========================================= */

    section {
      position: relative;
      padding: 120px 6%;
    }

    .section-heading {
      max-width: 800px;
      margin: 0 auto 65px;
      text-align: center;
    }

    .section-kicker {
      color: var(--gold);
      font-size: 0.7rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 14px;
    }

    .section-title {
      font-family: "Cinzel", serif;
      font-size: clamp(2rem, 5vw, 3.8rem);
      line-height: 1.1;
      color: #fff8db;
    }

    .section-description {
      margin-top: 18px;
      color: var(--muted);
      line-height: 1.8;
      font-size: 0.95rem;
    }

    /* =========================================
       COUNTDOWN
    ========================================= */

    .countdown-section {
      background:
        radial-gradient(circle at center, rgba(12,45,104,0.45), transparent 65%);
    }

    .countdown {
      max-width: 950px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .time-box {
      position: relative;
      padding: 35px 15px;
      text-align: center;
      border: 1px solid var(--border);
      background: linear-gradient(
        145deg,
        rgba(255,255,255,0.07),
        rgba(255,255,255,0.015)
      );
      backdrop-filter: blur(16px);
      border-radius: 18px;
      overflow: hidden;
      transform-style: preserve-3d;
      transition: transform 0.2s ease, border-color 0.3s ease;
      box-shadow: var(--shadow);
    }

    .time-box::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(
        circle at var(--card-x, 50%) var(--card-y, 50%),
        rgba(212,175,55,0.14),
        transparent 45%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .time-box:hover::before {
      opacity: 1;
    }

    .time-number {
      position: relative;
      font-family: "Cinzel", serif;
      font-size: clamp(2.5rem, 7vw, 5rem);
      line-height: 1;
      color: var(--gold-light);
      text-shadow: 0 0 25px rgba(212,175,55,0.18);
    }

    .time-label {
      position: relative;
      margin-top: 12px;
      color: var(--muted);
      font-size: 0.65rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
    }

    .event-note {
      text-align: center;
      margin-top: 25px;
      color: var(--muted);
      font-size: 0.8rem;
    }

    .event-note strong {
      color: var(--gold-light);
    }

    /* =========================================
       ABOUT
    ========================================= */

    .about-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .about-visual {
      min-height: 450px;
      position: relative;
      display: grid;
      place-items: center;
    }

    .orbit {
      position: absolute;
      border: 1px solid rgba(212,175,55,0.15);
      border-radius: 50%;
    }

    .orbit.one {
      width: 320px;
      height: 320px;
      animation: orbitSpin 14s linear infinite;
    }

    .orbit.two {
      width: 420px;
      height: 420px;
      border-style: dashed;
      animation: orbitSpin 22s linear infinite reverse;
    }

    .orbit-dot {
      position: absolute;
      top: -5px;
      left: 50%;
      width: 10px;
      height: 10px;
      background: var(--gold);
      border-radius: 50%;
      box-shadow: 0 0 20px var(--gold);
    }

    @keyframes orbitSpin {
      to { transform: rotate(360deg); }
    }

    .tarang-emblem {
      position: relative;
      z-index: 2;
      width: 230px;
      height: 230px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background:
        radial-gradient(circle, #123e89, #07132e 70%);
      border: 2px solid rgba(212,175,55,0.65);
      box-shadow:
        0 0 60px rgba(20,90,190,0.25),
        inset 0 0 40px rgba(212,175,55,0.08);
    }

    .tarang-emblem::before {
      content: "";
      position: absolute;
      inset: 13px;
      border: 1px solid rgba(212,175,55,0.3);
      border-radius: 50%;
    }

    .tarang-emblem span {
      font-family: "Cinzel", serif;
      font-size: 2.7rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      color: var(--gold-light);
    }

    .about-copy h3 {
      font-family: "Cinzel", serif;
      color: var(--gold-light);
      font-size: 1.7rem;
      margin-bottom: 20px;
    }

    .about-copy p {
      color: var(--muted);
      line-height: 1.9;
      font-size: 0.95rem;
      margin-bottom: 20px;
    }

    .highlight {
      color: white;
    }

    /* =========================================
       EXPERIENCE CARDS
    ========================================= */

    .experience {
      background:
        linear-gradient(
          180deg,
          transparent,
          rgba(8,25,58,0.45),
          transparent
        );
    }

    .card-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .glass-card {
      position: relative;
      min-height: 250px;
      padding: 35px;
      overflow: hidden;
      border-radius: 22px;
      border: 1px solid rgba(212,175,55,0.15);
      background: rgba(255,255,255,0.035);
      backdrop-filter: blur(15px);
      transition:
        transform 0.25s ease,
        border-color 0.3s ease,
        background 0.3s ease;
      transform-style: preserve-3d;
    }

    .glass-card::before {
      content: "";
      position: absolute;
      width: 200px;
      height: 200px;
      top: var(--card-y, 30%);
      left: var(--card-x, 30%);
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: rgba(212,175,55,0.1);
      filter: blur(50px);
      pointer-events: none;
    }

    .glass-card:hover {
      border-color: rgba(212,175,55,0.45);
      background: rgba(255,255,255,0.06);
    }

    .card-icon {
      width: 50px;
      height: 50px;
      display: grid;
      place-items: center;
      margin-bottom: 25px;
      border: 1px solid var(--border);
      border-radius: 14px;
      color: var(--gold);
      font-size: 1.4rem;
      background: rgba(212,175,55,0.06);
    }

    .glass-card h3 {
      font-family: "Cinzel", serif;
      color: #fff6d0;
      font-size: 1.25rem;
      margin-bottom: 12px;
    }

    .glass-card p {
      color: var(--muted);
      font-size: 0.85rem;
      line-height: 1.75;
    }

    /* =========================================
       EVENT INFO
    ========================================= */

    .info-wrap {
      max-width: 1000px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .info-card {
      padding: 30px 20px;
      text-align: center;
      border-radius: 18px;
      background: linear-gradient(
        145deg,
        rgba(12,45,104,0.42),
        rgba(255,255,255,0.025)
      );
      border: 1px solid rgba(212,175,55,0.15);
    }

    .info-icon {
      font-size: 1.8rem;
      margin-bottom: 15px;
    }

    .info-card small {
      display: block;
      color: var(--gold);
      letter-spacing: 0.18em;
      font-size: 0.62rem;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .info-card strong {
      color: white;
      font-size: 0.95rem;
    }

    /* =========================================
       CTA
    ========================================= */

    .cta {
      padding-top: 100px;
      padding-bottom: 140px;
    }

    .cta-box {
      position: relative;
      max-width: 1050px;
      margin: auto;
      padding: 80px 30px;
      overflow: hidden;
      text-align: center;
      border: 1px solid rgba(212,175,55,0.3);
      border-radius: 30px;
      background:
        radial-gradient(circle at center, rgba(20,72,150,0.35), transparent 70%),
        rgba(255,255,255,0.025);
      box-shadow: var(--shadow);
    }

    .cta-box::before,
    .cta-box::after {
      content: "";
      position: absolute;
      width: 220px;
      height: 220px;
      border: 1px solid rgba(212,175,55,0.12);
      border-radius: 50%;
    }

    .cta-box::before {
      left: -110px;
      top: -110px;
    }

    .cta-box::after {
      right: -110px;
      bottom: -110px;
    }

    .cta-box h2 {
      position: relative;
      font-family: "Cinzel", serif;
      font-size: clamp(2rem, 5vw, 4rem);
      color: var(--gold-light);
    }

    .cta-box p {
      position: relative;
      max-width: 650px;
      margin: 20px auto 30px;
      color: var(--muted);
      line-height: 1.8;
    }

    /* =========================================
       FOOTER
    ========================================= */

    footer {
      padding: 35px 6%;
      border-top: 1px solid rgba(212,175,55,0.1);
      text-align: center;
      color: #65738f;
      font-size: 0.72rem;
      line-height: 1.8;
    }

    footer strong {
      color: var(--gold);
    }

    /* =========================================
       REVEAL ANIMATION
    ========================================= */

    .reveal {
      opacity: 0;
      transform: translateY(35px);
      transition:
        opacity 0.8s ease,
        transform 0.8s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* =========================================
       MOBILE
    ========================================= */

    @media (max-width: 800px) {
      .nav-links {
        position: fixed;
        top: 75px;
        left: 5%;
        right: 5%;
        padding: 25px;
        flex-direction: column;
        gap: 22px;
        border-radius: 20px;
        background: rgba(5,11,28,0.95);
        border: 1px solid var(--border);
        backdrop-filter: blur(20px);
        transform: translateY(-20px);
        opacity: 0;
        pointer-events: none;
        transition: 0.3s ease;
      }

      .nav-links.open {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
      }

      .menu-btn {
        display: block;
      }

      .countdown {
        grid-template-columns: repeat(2, 1fr);
      }

      .about-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .about-visual {
        min-height: 380px;
      }

      .orbit.one {
        width: 270px;
        height: 270px;
      }

      .orbit.two {
        width: 340px;
        height: 340px;
      }

      .tarang-emblem {
        width: 190px;
        height: 190px;
      }

      .tarang-emblem span {
        font-size: 2.2rem;
      }

      .card-grid {
        grid-template-columns: 1fr;
      }

      .info-wrap {
        grid-template-columns: 1fr;
      }

      section {
        padding: 90px 5%;
      }
    }

    @media (max-width: 450px) {
      .hero {
        padding-top: 110px;
      }

      .hero-title {
        font-size: clamp(4.2rem, 24vw, 6rem);
      }

      .eyebrow {
        font-size: 0.62rem;
        letter-spacing: 0.17em;
      }

      .eyebrow::before,
      .eyebrow::after {
        width: 20px;
      }

      .hero-details {
        gap: 8px;
      }

